# Copie este arquivo para ".env" e ajuste os valores.

# Porta HTTP da API.
PORT=3000

# Banco SQLite. Caminho relativo é resolvido a partir da pasta "prisma/".
DATABASE_URL="file:./dev.db"

# Banco usado: "sqlite" (padrão) ou "postgresql".
# Com "postgresql", use por exemplo:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/prototypes"
DATABASE_PROVIDER=sqlite

# Segredo para assinar os tokens JWT (obrigatório, 32 caracteres ou mais).
# Gere um valor aleatório com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio"

# Validade dos tokens, em segundos (acesso: 15 min; renovação: 7 dias).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
