{
  "name": "projeto-typescript-prototype",
  "version": "2.3.0",
  "description": "Padrões de projeto em TypeScript (Prototype, Builder, Factory Method, Abstract Factory, Observer/EventBus, Strategy de Multas Progressivas, Adapter, Decorator, State e Chain of Responsibility), com uma API NestJS + Prisma (SQLite ou PostgreSQL), repositório com paginação e filtros dinâmicos, métricas Prometheus/JSON, autenticação JWT, Correlation-ID e demonstração interativa dos padrões.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "examples": "npm run build && node dist/prototype-pattern/examples/index.js && node dist/design-patterns/examples.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "node prisma/prisma-cli.mjs generate",
    "prisma:migrate": "node prisma/prisma-cli.mjs migrate dev",
    "prisma:deploy": "node prisma/prisma-cli.mjs migrate deploy",
    "prisma:seed": "node prisma/prisma-cli.mjs db seed",
    "db:seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
}
